def load_posted_jobs():
    if os.path.exists(POSTED_JOBS_FILE):
        try:
            with open(POSTED_JOBS_FILE, 'r') as f:
                return set(json.load(f))
        except:
            return set()
    return set()

def save_posted_jobs(posted_jobs):
    with open(POSTED_JOBS_FILE, 'w') as f:
        json.dump(list(posted_jobs), f)

def send_discord_message(content):
    payload = {"content": content}
    try:
        requests.post(WEBHOOK_URL, json=payload)
    except Exception as e:
        print(f"Error sending to Discord: {e}")

def get_job_report(new_jobs):
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    report = f"🚀 **Hourly Job Update - {now}**\n\n### **QA & Manual Testing (New/Verified)**\n"
    
    for job in new_jobs:
        report += f"- [{job['title']} @ {job['company']}]({job['link']}) ({job['location']})\n"
    
    report += "\n**QA Lead Tip:** All links verified for May 23. Manual QA roles are your strongest pivot right now!"
    return report

def main():
    print(f"[{datetime.now()}] Job Automation Script Started.")
    posted_jobs = load_posted_jobs()
    
    while True:
        now = datetime.now()
        # Schedule: Every hour between 9:00 AM and 11:00 PM daily
        if 9 <= now.hour <= 23:
            # Filter for jobs we haven't posted yet
            new_jobs_to_post = []
            for job in JOBS_DATA:
                job_id = f"{job['title']}|{job['company']}|{job['link']}"
                if job_id not in posted_jobs:
                    new_jobs_to_post.append(job)
                    posted_jobs.add(job_id)
            
            if new_jobs_to_post:
                print(f"[{now}] Posting {len(new_jobs_to_post)} new jobs...")
                report = get_job_report(new_jobs_to_post)
                send_discord_message(report)
                save_posted_jobs(posted_jobs)
            else:
                print(f"[{now}] No new jobs to post this hour.")
            
            # Wait for 1 hour
            time.sleep(3600)
        else:
            # Check every 15 minutes if we've entered the 9am-11pm window
            print(f"[{now}] Outside posting window (9AM-11PM). Sleeping for 15 mins...")
            time.sleep(900)

if __name__ == "__main__":
    main()
